<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/somessay_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center">


        <!-- Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_beige"
            android:padding="28dp">

            <!-- App name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="somessay."
                android:textSize="32sp"
                android:textColor="@color/somessay_dark"
                android:fontFamily="@font/instrument_serif"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="welcome to somessay."
                android:textSize="16sp"
                android:textColor="@color/somessay_warm_text"
                android:fontFamily="@font/instrument_serif"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="a place to tell your written roots."
                android:textSize="13sp"
                android:textColor="@color/somessay_warm_text"
                android:layout_marginBottom="28dp"/>

            <!-- Username -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textSize="13sp"
                android:textColor="@color/somessay_dark"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="14dp"
                android:hint="Enter your username"
                android:textColor="@color/somessay_dark"
                android:inputType="text"
                android:layout_marginBottom="16dp"/>

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="13sp"
                android:textColor="@color/somessay_dark"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="14dp"
                android:hint="Enter your email"
                android:textColor="@color/somessay_dark"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="16dp"/>

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textSize="13sp"
                android:textColor="@color/somessay_dark"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="14dp"
                android:hint="Enter your password"
                android:textColor="@color/somessay_dark"
                android:inputType="textPassword"
                android:layout_marginBottom="16dp"/>

            <!-- Confirm Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm Password"
                android:textSize="13sp"
                android:textColor="@color/somessay_dark"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="14dp"
                android:hint="Confirm your password"
                android:textColor="@color/somessay_dark"
                android:inputType="textPassword"
                android:layout_marginBottom="8dp"/>

            <!-- Error -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/somessay_error"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp"/>

            <!-- Register button -->
            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="enter the seasons"
                android:textColor="@color/somessay_white"
                android:backgroundTint="@color/somessay_green"
                android:layout_marginTop="8dp"/>

            <!-- Go to login -->
            <TextView
                android:id="@+id/tvGoToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="already have an account? log in"
                android:textColor="@color/somessay_warm_text"
                android:textSize="13sp"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>